{
  "name": "web-main",
  "version": "1.0.0",
  "private": true,
  "description": "Sitio web publico de Grupo Terna (GitHub Pages). No es un paquete npm publicable; package.json existe solo para las herramientas de CI (B-15).",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "check-links": "node scripts/check-local-links.js",
    "check-changelog": "node scripts/verificar-changelog.js",
    "lint": "eslint assets",
    "validate-html": "html-validate *.html",
    "test": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./scripts/reporter-github.js --test-reporter-destination=stdout"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "html-validate": "^11.21.1",
    "jsdom": "^30.1.1"
  }
}
